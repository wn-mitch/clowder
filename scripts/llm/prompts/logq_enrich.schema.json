{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["hint", "suggestions"],
  "additionalProperties": false,
  "properties": {
    "hint": {
      "type": "string",
      "maxLength": 400
    },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["cmd", "why"],
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "type": "string",
            "maxLength": 300
          },
          "why": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    }
  }
}
